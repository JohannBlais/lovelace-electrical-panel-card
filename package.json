{
  "name": "lovelace-electrical-panel-card",
  "version": "0.19.0",
  "description": "Custom Lovelace card for Home Assistant — interactive one-line electrical panel diagram with live power readings, smart-plug toggles, and per-circuit/per-zone breakdown.",
  "keywords": [
    "home-assistant",
    "lovelace",
    "lovelace-custom-card",
    "hacs",
    "electrical",
    "energy",
    "custom-card"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JohannBlais/lovelace-electrical-panel-card.git"
  },
  "bugs": {
    "url": "https://github.com/JohannBlais/lovelace-electrical-panel-card/issues"
  },
  "homepage": "https://github.com/JohannBlais/lovelace-electrical-panel-card#readme",
  "author": "Johann Blais",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "build:dev": "rollup -c --environment DEV_TAG:1",
    "watch": "rollup -c -w",
    "watch:dev": "rollup -c -w --environment DEV_TAG:1",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "generate-previews": "node scripts/generate-previews.mjs",
    "smoke-test": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "custom-card-helpers": "^2.0.0",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mdi/js": "^7.4.47",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.13.0",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "js-yaml": "^5.2.2",
    "jsdom": "^30.0.1",
    "opentype.js": "^2.0.0",
    "roboto-fontface": "^0.10.0",
    "rollup": "^4.62.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  }
}
